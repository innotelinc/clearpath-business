<%- include("partials/head") %>

<section class="hero">
  <p class="eyebrow">Denovo Credit · since 1999</p>
  <h1>Business credit that belongs to the company, not your SSN.</h1>
  <p class="lede">
    ClearPath Business builds the commercial file underwriters actually read: entity, EIN, DUNS,
    reporting vendor tradelines and bank lines sized to real revenue. Personal credit repair stays
    with Denovo's original program.
  </p>
  <div class="hero-actions">
    <a class="btn" href="#intake">Request a free review</a>
    <a class="btn ghost" href="tel:<%= product.phone.replace(/[^0-9+]/g, "") %>">Call <%= product.phone %></a>
  </div>
</section>

<% if (sent) { %>
  <p class="flash ok">Request received. A Denovo strategist will call within one business day.</p>
<% } %>

<section class="grid-two">
  <div class="card">
    <h2>The build, in four stages</h2>
    <ol class="stages">
      <% stages.forEach(function (stage) { %>
        <li>
          <span class="tier"><%= stage.tier %></span>
          <strong><%= stage.name %></strong>
          <span class="muted"><%= stage.window %></span>
        </li>
      <% }); %>
    </ol>
  </div>

  <div class="card" id="intake">
    <h2>Request your free first review</h2>
    <p class="muted">Tell us where the business stands. No credit pull, no upfront fee.</p>
    <form method="post" action="/intake" class="stack">
      <label>Name <input name="name" required maxlength="120" autocomplete="name" /></label>
      <label>Email <input name="email" type="email" required maxlength="160" autocomplete="email" /></label>
      <label>Phone <input name="phone" maxlength="40" autocomplete="tel" /></label>
      <label>Business name <input name="business" maxlength="160" /></label>
      <label>
        What do you need?
        <select name="interest">
          <option>Business credit build</option>
          <option>Personal credit repair</option>
          <option>Both programs</option>
          <option>Business credit audit</option>
        </select>
      </label>
      <label>Anything else? <textarea name="message" rows="3" maxlength="2000"></textarea></label>
      <div class="hp" aria-hidden="true">
        <label>Company website <input name="company_website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button class="btn" type="submit">Request my free review</button>
      <p class="fineprint">
        We do not guarantee any score, limit or approval. Business credit programs are separate from
        consumer credit repair.
      </p>
    </form>
  </div>
</section>

<section class="strip">
  <div><strong>3</strong><span>business bureaus tracked</span></div>
  <div><strong>4</strong><span>stages in the build</span></div>
  <div><strong>5+</strong><span>reporting tradelines targeted</span></div>
  <div><strong>90</strong><span>days to first reporting accounts</span></div>
</section>

<%- include("partials/foot") %>
