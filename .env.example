# ClearPath Business — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets belong in Cerulean Vault and are referenced as
# vault:///<mount>/<path>#<KEY>, the same convention as innotelinc/clearpath.

# HTTP port
PORT=3100

# Public origin used in links and cookies
APP_ORIGIN=http://localhost:3100

# Upload/data directory
DATA_DIR=./data

# SQLite database file
DB_PATH=./data/clearpath-business.db

# Set to 1 behind HTTPS
COOKIE_SECURE=0

# First workspace operator
PLATFORM_ADMIN_EMAIL=admin@denovocredit.com
PLATFORM_ADMIN_PASSWORD=change-me

# Shown to clients in the portal and on generated paperwork
SUPPORT_EMAIL=hello@denovocredit.com
SUPPORT_PHONE=(774) 505-7135

# Denovo Credit public site — used for links, phone and legal identity
DENOVO_SITE_URL=https://denovocredit.com

# Where new business-credit leads are pushed for the Denovo team.
# Leave empty to store leads only (they still appear in /app/leads).
DENOVO_WEBHOOK_URL=

# Shared secret for the signed lead handoff, in both directions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DENOVO_SHARED_SECRET=

# Seed demonstration businesses on boot (set 0 in production)
SEED_DEMO=1
